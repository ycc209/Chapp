# Meta Model API key (https://dev.meta.ai). Never commit the real .env.
MODEL_API_KEY=
# Who answers /api/voice, /api/converse and /api/find-protocol:
#   mock  fixed answers from the BCA kit, no network, no cost (use this while building screens)
#   meta  Meta's models (Muse Spark, Muse Voice Transcribe); needs MODEL_API_KEY
# Left empty: meta when MODEL_API_KEY is set, otherwise mock.
AI_PROVIDER=
HOST=127.0.0.1
PORT=3003
# Web Push (time's up on the lock screen): the contact push services see in the VAPID signature, mailto: or https:.
# Keys are made once into data/push/ (git-ignored). Left empty: mailto:chapp@example.com.
PUSH_SUBJECT=
# Only for the import benchmark (scripts/bench/), never used by the app. Claude and OpenAI through their APIs:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# The benchmark's Claude Code runs (claude -p on a subscription) when the CLI's own login cannot be read here:
# a token from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# The most Chapp spends on Meta's models in a day, in US dollars (server/ai/usage.ts). Once reached, calls are refused
# until tomorrow, and a manual is counted before it is read. Empty: no cap.
CHAPP_DAILY_USD=

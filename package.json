{
  "name": "chapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chapp: a voice-first lab companion that knows every vial in your kit. Built for the Meta Global AI Developer Hackathon.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:phone": "HTTPS=1 vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "smoke": "node --env-file-if-exists=.env scripts/smoke-meta.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openai": "7.43.0",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  }
}
